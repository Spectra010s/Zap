# Zap Platform Frontend Environment Configuration
# Copy this file to .env and update the values

# API Configuration
REACT_APP_API_URL=your-backend-url/api/v1
REACT_APP_URL=your-backend-url

# Development Settings (only used in development)
# HOST=0.0.0.0    # Uncomment to allow access from other devices
# PORT=3000
# BROWSER=none